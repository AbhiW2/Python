    "#Check Given num even or odd\n",
    "\n",
    "num=int(input(\"Enter a number: \"))\n",
    "print(\"Given number is: \",num)\n",
    "\n",
    "if(num%2==0):\n",
    "    print(\"Your Entered number is Even:\", num)\n",
    "else:\n",
    "    print(\"Your Entered number is Odd:\", num)\n"
   ]
